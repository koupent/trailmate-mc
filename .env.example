# Copy to .env:
#   cp .env.example .env
#
# MC_HOST/MC_PORT are Trailmate MC -> ViaProxy only.
# Put the real Minecraft server address in services/viaproxy/viaproxy.yml (target-address).

MC_HOST=viaproxy
MC_PORT=25568
MC_AUTH=offline

# Offline username presented by Mineflayer to ViaProxy only.
# With ViaProxy auth-method ACCOUNT, the in-world name is the Microsoft
# Minecraft profile name (not this value). With auth-method NONE, this is
# the offline in-world name.
BOT_NAME=Trailmate

# Temporary structured combat telemetry (exactly 1 enables; 0/default disables)
COMBAT_TRACE=0

# Optional: path to config.json (defaults to ./config.json)
# CONFIG_PATH=./config.json

# Local control API inside the trailmate container (dashboard talks to this)
# CONTROL_PORT=8790
